{
    "name": "react-diff-image",
    "version": "2.1.1",
    "description": "Zero-dependency component for multi-modal image comparison and review.",
    "keywords": [
        "compare",
        "comparison",
        "diff",
        "image",
        "react",
        "review"
    ],
    "homepage": "https://github.com/ianobermiller/react-diff-image#readme",
    "bugs": {
        "url": "https://github.com/ianobermiller/react-diff-image/issues"
    },
    "license": "MIT",
    "author": "Ian Obermiller <ian@obermillers.com>",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/ianobermiller/react-diff-image.git"
    },
    "files": [
        "dist"
    ],
    "sideEffects": false,
    "main": "./dist/index.js",
    "module": "./dist/index.mjs",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "import": {
                "types": "./dist/index.d.mts",
                "default": "./dist/index.mjs"
            },
            "require": {
                "types": "./dist/index.d.ts",
                "default": "./dist/index.js"
            }
        }
    },
    "scripts": {
        "build": "tsdown",
        "demo:build": "tsdown --config tsdown-demo.config.mts --env.NODE_ENV production",
        "demo:watch": "tsdown --config tsdown-demo.config.mts --watch",
        "demo:serve": "node perf/server.mjs dist-demo 3000",
        "tsc": "tsc --noEmit",
        "lint": "oxlint --type-aware --deny-warnings src tests/*.ts tests/*.tsx *.config.mts && oxlint --deny-warnings perf tests/*.mjs",
        "lint:fix": "oxlint --type-aware --fix --deny-warnings src tests/*.ts tests/*.tsx *.config.mts && oxlint --fix --deny-warnings perf tests/*.mjs",
        "format": "oxfmt --check .",
        "format:fix": "oxfmt --write .",
        "test": "npm run build && npm run test:package && npm run test:browser",
        "test:package": "node --test tests/package.test.mjs",
        "test:browser": "playwright test",
        "check": "npm run build && npm run tsc && npm run lint && npm run format && npm run test:package && npm run test:browser",
        "prepublishOnly": "npm run check"
    },
    "devDependencies": {
        "@playwright/test": "^1.65.1",
        "@types/node": "^24.19.2",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "oxfmt": "^0.79.0",
        "oxlint": "^1.94.0",
        "oxlint-tsgolint": "^7.0.2008",
        "react": "^19.3.1",
        "react-dom": "^19.3.1",
        "tsdown": "^0.23.7",
        "typescript": "^7.0.2"
    },
    "peerDependencies": {
        "react": "^16.14.0 || ^17.0.0 || ^18.0.0 || ^19.0.0"
    },
    "devEngines": {
        "runtime": {
            "name": "node",
            "version": ">=24.11.0",
            "onFail": "error"
        }
    }
}
